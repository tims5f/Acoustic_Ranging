execUserAttach()
{
 __message "uwTick=", __readMemory32(0x20014bfc, "Memory"), "\n";
 __message "trigger_event_id=", __readMemory32(0x2002c728, "Memory"), "\n";
 __message "trigger_accepted_count=", __readMemory32(0x2002c72c, "Memory"), "\n";
 __message "measure_history_count=", __readMemory32(0x2002bdb8, "Memory"), "\n";
 __message "correlation_reject_count=", __readMemory32(0x20021d48, "Memory"), "\n";
 __message "measure_impulse_pairs=", __readMemory32(0x20021d2c, "Memory"), "\n";
 __message "measure_kind_mismatch=", __readMemory32(0x20021d30, "Memory"), "\n";
 __message "measure_impulse_rejects=", __readMemory32(0x20021d34, "Memory"), "\n";
 __message "audio_noise_level=", __readMemory16(0x2002c710, "Memory"), "\n";
 __message "audio_adaptive_gate=", __readMemory16(0x2002c712, "Memory"), "\n";
 __message "last_reject_reason=", __readMemory8(0x2002437c, "Memory"), "\n";
 __message "last_correlation_permille=", __readMemory16(0x2002437e, "Memory"), "\n";
 __message "clock_state=", __readMemory8(0x2002cae8, "Memory"), "\n";
 __message "peer_online=", __readMemory8(0x2002cd6c, "Memory"), "\n";
 __message "ethernet_tx_failures=", __readMemory32(0x2002cf20, "Memory"), "\n";
}