execUserAttach()
{
  __message "uwTick=", __readMemory32(0x20014bfc, "Memory"), "\n";
  __message "dht_attempts=", __readMemory32(0x2002ce70, "Memory"), "\n";
  __message "dht_successes=", __readMemory32(0x2002ce74, "Memory"), "\n";
  __message "dht_checksum_errors=", __readMemory32(0x2002ce78, "Memory"), "\n";
  __message "dht_timeout_errors=", __readMemory32(0x2002ce7c, "Memory"), "\n";
  __message "dht_state=", __readMemory8(0x2002ce58, "Memory"), "\n";
  __message "dht_bits=", __readMemory8(0x2002ce59, "Memory"), "\n";
  __message "dht_temperature_deci_c=", __readMemory16(0x2002ce64, "Memory"), "\n";
  __message "dht_humidity_deci_percent=", __readMemory16(0x2002ce66, "Memory"), "\n";
  __message "local_valid=", __readMemory8(0x20014984, "Memory"), "\n";
  __message "peer_valid=", __readMemory8(0x20014985, "Memory"), "\n";
  __message "local_temperature=", __readMemory16(0x2001498e, "Memory"), "\n";
  __message "peer_temperature=", __readMemory16(0x20014990, "Memory"), "\n";
  __message "selected_temperature=", __readMemory16(0x20014994, "Memory"), "\n";
  __message "ready=", __readMemory8(0x20014987, "Memory"), "\n";
  __message "source=", __readMemory8(0x20014988, "Memory"), "\n";
  __message "automatic=", __readMemory8(0x20014986, "Memory"), "\n";
  __message "local_role=", __readMemory8(0x2002cd67, "Memory"), "\n";
  __message "clock_state=", __readMemory8(0x2002cae0, "Memory"), "\n";
  __message "measure_history_count=", __readMemory32(0x2002bdb0, "Memory"), "\n";
  __message "UID0=", __readMemory32(0x1ff0f420, "Memory"), "\n";
  __message "UID1=", __readMemory32(0x1ff0f424, "Memory"), "\n";
  __message "UID2=", __readMemory32(0x1ff0f428, "Memory"), "\n";
}
